# Copy to .env and fill in. docker-compose reads this automatically.

# Pin to a vLLM release you've validated (recommended over "latest").
VLLM_TAG=latest

# Base model. gemma-3-4b-it is gated on Hugging Face -> set HF_TOKEN.
MODEL_ID=google/gemma-3-4b-it
HF_TOKEN=

# Default S3 location for adapters. A load request for lora_name "foo"
# with no explicit s3_uri resolves to "${LORA_S3_PREFIX}/foo".
LORA_S3_PREFIX=s3://my-bucket/loras
AWS_REGION=us-east-1

# vLLM tuning (A10G / 24GB defaults)
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=8192
MAX_LORA_RANK=32
